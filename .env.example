# Copy this file to .env before running `docker compose up`.
# Never commit the real .env -- it's gitignored.

# --- Postgres (container: postgres) ---
DB_USER=absensi
DB_PASSWORD=absensi_dev_password
DB_NAME=absensi

# --- Go API (container: api) ---
# Host name is the compose service name `postgres`, not localhost --
# containers reach each other by service name on the compose network.
DATABASE_URL=postgres://absensi:absensi_dev_password@postgres:5432/absensi?sslmode=disable
JWT_SECRET=dev-only-change-me
PORT=8080
STORAGE_DIR=storage
# Access token lifetime. Default 900s (15 min); the web app's middleware
# silently refreshes it before expiry using the refresh token cookie, so
# this mostly matters for how often that refresh call happens.
ACCESS_TOKEN_TTL_SECONDS=900
# D-17 flag-no-checkout job (dev defaults set short so you can see it run
# without waiting hours; production values are commented below)
FLAG_JOB_INTERVAL_MINUTES=2
FLAG_JOB_STALE_AFTER_MINUTES=5
# FLAG_JOB_INTERVAL_MINUTES=60
# FLAG_JOB_STALE_AFTER_MINUTES=720

# --- Next.js (container: web) ---
# This one IS accessed from the browser on the host, so it must point at
# localhost (the port published by the `api` container), not the service name.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Map tiles for <GeofenceMap> (Leaflet + OpenStreetMap, no Google Maps/Mapbox
# API key needed). This default points at OSM's public tile server, which is
# fine for dev but its usage policy (https://operations.osmfoundation.org/policies/tiles/)
# explicitly disallows heavy/commercial production traffic -- before going to
# production, switch this to a provider with an SLA (MapTiler, Stadia Maps,
# etc.) or a self-hosted tile server, and set it here, not in code.
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
